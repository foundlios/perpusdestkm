s\main.php";s:4:"line";i:72;s:8:"function";s:6:"render";s:5:"class";s:13:"yii\base\View";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:90:"C:\xampp\htdocs\inlislite3\backend\modules\pengkatalogan\controllers\KatalogController.php";s:4:"line";i:1304;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:229;a:5:{i:0;s:41:"SHOW FULL COLUMNS FROM `location_library`";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780140566.564405;i:4;a:3:{i:0;a:5:{s:4:"file";s:81:"C:\xampp\htdocs\inlislite3\inliscore\kw-themes-adminlte\views\layouts\heading.php";s:4:"line";i:21;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:78:"C:\xampp\htdocs\inlislite3\inliscore\kw-themes-adminlte\views\layouts\main.php";s:4:"line";i:72;s:8:"function";s:6:"render";s:5:"class";s:13:"yii\base\View";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:90:"C:\xampp\htdocs\inlislite3\backend\modules\pengkatalogan\controllers\KatalogController.php";s:4:"line";i:1304;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:231;a:5:{i:0;s:619:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
