    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'worksheets' AND kcu.table_name = 'worksheets'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780140566.4725299;i:4;a:3:{i:0;a:5:{s:4:"file";s:90:"C:\xampp\htdocs\inlislite3\backend\modules\pengkatalogan\views\katalog\_searchAdvanced.php";s:4:"line";i:42;s:8:"function";s:3:"all";s:5:"class";s:18:"yii\db\ActiveQuery";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:80:"C:\xampp\htdocs\inlislite3\backend\modules\pengkatalogan\views\katalog\index.php";s:4:"line";i:68;s:8:"function";s:6:"render";s:5:"class";s:13:"yii\base\View";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:90:"C:\xampp\htdocs\inlislite3\backend\modules\pengkatalogan\controllers\KatalogController.php";s:4:"line";i:1304;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:91;a:5:{i:0;s:607:"SELECT
