;s:8:"function";s:21:"renderDataCellContent";s:5:"class";s:19:"yii\grid\DataColumn";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\vendor\kartik-v\yii2-grid\GridView.php";s:4:"line";i:804;s:8:"function";s:15:"renderTableBody";s:5:"class";s:17:"yii\grid\GridView";s:4:"type";s:2:"->";}}}i:792;a:5:{i:0;s:66:"SELECT `id` FROM `session` WHERE `id`='cbosp3p2k29cc979u2s7d9cil6'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780140893.719409;i:4;a:0:{}}i:795;a:5:{i:0;s:32:"SHOW FULL COLUMNS FROM `session`";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780140893.7196679;i:4;a:0:{}}i:798;a:5:{i:0;s:601:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
