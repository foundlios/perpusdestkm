    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'collections' AND kcu.table_name = 'collections'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780140796.026228;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\vendor\kartik-v\yii2-grid\GridView.php";s:4:"line";i:774;s:8:"function";s:3:"run";s:5:"class";s:17:"yii\grid\GridView";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:75:"C:\xampp\htdocs\inlislite3\backend\modules\akuisisi\views\koleksi\index.php";s:4:"line";i:351;s:8:"function";s:6:"widget";s:5:"class";s:15:"yii\base\Widget";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:85:"C:\xampp\htdocs\inlislite3\backend\modules\akuisisi\controllers\KoleksiController.php";s:4:"line";i:2450;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:161;a:5:{i:0;s:609:"SELECT
