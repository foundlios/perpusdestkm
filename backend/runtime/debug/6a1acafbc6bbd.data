                        ,' ',catalogs.PublishYear
                        ,(CASE WHEN catalogs.PhysicalDescription IS NOT NULL THEN CONCAT('<br/>',catalogs.PhysicalDescription) ELSE '' END)
                        ,(CASE WHEN EDISISERIAL IS NOT NULL THEN CONCAT('<br/>',EDISISERIAL) ELSE '' END)
                        ,'<br/>',worksheets.name,'</div>'
                        ) AS DataBib FROM `collections` LEFT JOIN `collectionsources` ON `collections`.`Source_id` = `collectionsources`.`ID` LEFT JOIN `collectionmedias` ON `collections`.`Media_id` = `collectionmedias`.`ID` LEFT JOIN `collectioncategorys` ON `collections`.`Category_id` = `collectioncategorys`.`ID` LEFT JOIN `collectionrules` ON `collections`.`Rule_id` = `collectionrules`.`ID` LEFT JOIN `locations` ON `collections`.`Location_id` = `locations`.`ID` LEFT JOIN `location_library` ON `collections`.`Location_Library_id` = `location_library`.`ID` LEFT JOIN `collectionstatus` ON `collections`.`Status_id` = `collectionstatus`.`ID` LEFT JOIN `catalogs` ON  collections.Catalog_id = catalogs.id LEFT JOIN `worksheets` ON  catalogs.Worksheet_id = worksheets.id LEFT JOIN `users` `usr_create` ON  usr_create.ID = collections.CreateBy LEFT JOIN `users` `usr_update` ON  usr_update.ID = collections.UpdateBy ORDER BY `NomorBarcode` LIMIT 200";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780140795.9694009;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\vendor\kartik-v\yii2-grid\GridView.php";s:4:"line";i:774;s:8:"function";s:3:"run";s:5:"class";s:17:"yii\grid\GridView";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:75:"C:\xampp\htdocs\inlislite3\backend\modules\akuisisi\views\koleksi\index.php";s:4:"line";i:351;s:8:"function";s:6:"widget";s:5:"class";s:15:"yii\base\Widget";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:85:"C:\xampp\htdocs\inlislite3\backend\modules\akuisisi\controllers\KoleksiController.php";s:4:"line";i:2450;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:156;a:5:{i:0;s:36:"SHOW FULL COLUMNS FROM `collections`";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780140795.975045;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\vendor\kartik-v\yii2-grid\GridView.php";s:4:"line";i:774;s:8:"function";s:3:"run";s:5:"class";s:17:"yii\grid\GridView";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:75:"C: