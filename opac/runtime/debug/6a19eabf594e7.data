    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'worksheets' AND kcu.table_name = 'worksheets'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4534791;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:265;s:8:"function";s:15:"GetDirWorksheet";s:5:"class";s:34:"common\components\DirectoryHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:91;a:5:{i:0;s:41:"SELECT * FROM `worksheets` WHERE `ID`='1'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4539161;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:265;s:8:"function";s:15:"GetDirWorksheet";s:5:"class";s:34:"common\components\DirectoryHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:94;a:5:{i:0;s:41:"SELECT * FROM `worksheets` WHERE `ID`='1'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4600661;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\r