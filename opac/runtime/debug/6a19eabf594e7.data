                      FROM
                        (SELECT GROUP_CONCAT(Y.VAL1 SEPARATOR ' ') AS RTRIM1
                        FROM
                          (SELECT *
                          FROM (
                            (SELECT CS.sequence,
                              CS.Ruasid,
                              CASE
                                WHEN CS.SUBRUAS = 'e'
                                THEN CONCAT ( '(' , CS.Value , ') |' )
                                ELSE CS.Value
                              END AS VAL1
                            FROM catalog_subruas CS
                            LEFT JOIN catalog_ruas CR
                            ON CS.RuasID       = CR.ID
                            WHERE CR.CatalogId = 1
                            AND CR.Tag        IN (100,110,111,700,710,711,800,810,811)
                            AND CS.Subruas    IN ('a', 'd' ,'e')
                            GROUP BY CS.Ruasid,
                              CS.SUBRUAS,
                              CS.Value,
                              CS.Sequence
                            )) X
                          ORDER BY ruasid,
                            sequence
                          ) Y
                        GROUP BY Ruasid
                        ) Z
                ) AS PENGARANG FROM catalogs C WHERE C.ID = 1 AND isopac = 1";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4374001;i:4;a:2:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:1781;s:8:"function";s:11:"queryScalar";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:315;s:8:"function";s:13:"sqlDetailOpac";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}}}i:80;a:5:{i:0;s:1426:"Select (SELECT GROUP_CONCAT(Z.RTRIM1 SEPARATOR '|') AS RTRIM2 
                      FROM
                        (SELECT GROUP_CONCAT(Y.VAL1 SEPARATOR ' ') AS RTRIM1
                        FROM
                          (SELECT *
                          FROM (
                            (SELECT CS.sequence,
                              CS.Ruasid,
                              CASE
                                WHEN CS.SUBRUAS = 'e'
                                THEN CONCAT ( '(' , CS.Value , ') |' )
                                ELSE CS.Value
                              END AS VAL1
                            FROM catalog_subruas CS
                            LEFT JOIN catalog_ruas CR
                            ON CS.RuasID       = CR.ID
                            WHERE CR.CatalogId = 1
                            AND CR.Tag        IN (100,110,111,700,710,711,800,810,811)
                            AND CS.Subruas    IN ('a', 'd' ,'e')
                            GROUP BY CS.Ruasid,
                              CS.SUBRUAS,
                              CS.Value,
                              CS.Sequence
                            )) X
                          ORDER BY ruasid,
                            sequence
                          ) Y
                        GROUP BY Ruasid
                        ) Z
                ) AS PENGARANG FROM catalogs C WHERE C.ID = 1 AND isopac = 1";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4441171;i:4;a:2:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:1781;s:8:"function";s:11:"queryScalar";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:315;s:8:"function";s:13:"sqlDetailOpac";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}}}i:83;a:5:{i:0;s:44:" select Publikasi from catalogs where  ID =1";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4488089;i:4;a:3:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:670;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:259;s:8:"function";s:12:"getPublisher";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:84;a:5:{i:0;s:44:" select Publikasi from catalogs where  ID =1";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.448987;i:4;a:3:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:670;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:259;s:8:"function";s:12:"getPublisher";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaControll