                          ) Y
                        GROUP BY Ruasid
                        ) Z
                ) AS PENGARANG FROM catalogs C WHERE C.ID = 1 AND isopac = 1";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4441171;i:4;a:2:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:1781;s:8:"function";s:11:"queryScalar";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:315;s:8:"function";s:13:"sqlDetailOpac";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}}}i:83;a:5:{i:0;s:44:" select Publikasi from catalogs where  ID =1";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4488089;i:4;a:3:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:670;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:259;s:8:"function";s:12:"getPublisher";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:84;a:5:{i:0;s:44:" select Publikasi from catalogs where  ID =1";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.448987;i:4;a:3:{i:0;a:5:{s:4:"file";s:60:"C:\xampp\htdocs\inlislite3\common\components\OpacHelpers.php";s:4:"line";i:670;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:259;s:8:"function";s:12:"getPublisher";s:5:"class";s:29:"common\components\OpacHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:86;a:5:{i:0;s:35:"SHOW FULL COLUMNS FROM `worksheets`";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4513161;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:265;s:8:"function";s:15:"GetDirWorksheet";s:5:"class";s:34:"common\components\DirectoryHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:87;a:5:{i:0;s:35:"SHOW FULL COLUMNS FROM `worksheets`";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.4530399;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:265;s:8:"function";s:15:"GetDirWorksheet";s:5:"class";s:34:"common\components\DirectoryHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:89;a:5:{i:0;s:607:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'worksheets' AND kcu.table_name = 'worksheets'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1780083391.45351;i:4;a:3:{i:0;a:5:{s:4:"file";s:65:"C:\xampp\htdocs\inlislite3\common\components\DirectoryHelpers.php";s:4:"line";i:34;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}i:1;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\views\pencarian-sederhana\resultListOpac.php";s:4:"line";i:265;s:8:"function";s:15:"GetDirWorksheet";s:5:"class";s:34:"common\components\DirectoryHelpers";s:4:"type";s:2:"::";}i:2;a:5:{s:4:"file";s:76:"C:\xampp\htdocs\inlislite3\opac\controllers\PencarianSederhanaController.php";s:4:"line";i:464;s:8:"function";s:6:"render";s:5:"class";s:19:"yii\base\Controller";s:4:"type";s:2:"->";}}}i:90;a:5:{i:0;s:607:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
